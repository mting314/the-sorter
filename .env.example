# Build-time public env vars for the-sorter.
# These are read by vite.config.ts from the environment at build time
# (pass on the CLI / in CI, e.g. `PUBLIC_ENV__BASE_URL=/the-sorter bun run ci:build`).

# Base path the site is served under (GitHub Pages project site -> /the-sorter).
# Leave empty for local dev (served at /).
PUBLIC_ENV__BASE_URL=

# Networked source for the "ranking rankings" user data.
# When empty, the frontend fetches the same-origin static asset:
#   ${BASE_URL}data/user-song-rankings.json
# Override with any CORS-enabled absolute URL to host the data elsewhere, e.g.:
#   https://raw.githubusercontent.com/mting314/the-sorter/main/public/data/user-song-rankings.json
#   https://cdn.example.com/the-sorter/user-song-rankings.json
PUBLIC_ENV__RANKINGS_URL=
